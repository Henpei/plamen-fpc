# ---- pools per rarity (0=Grå .. 5=Mythforged); count rolled = RARITY_AFFIX_COUNT ----
[pool:0]
affixes=

[pool:1]
affixes=of_might:10|of_wits:10|of_grace:10|of_spirit:10|of_resolve:10|of_vigor:8|of_breath:6|of_the_axe:8|of_the_phoenix:4|of_the_river:4|of_the_thicket:4|of_the_storm:4|of_the_abyss:4

