# Affixes (brief 4.4). [affix:id] stat must exist in stats.dat (validated at load).
# [pool:N] = rarity N (0..5) affix pool; refs are affixId:weight. Roll value = min + rnd*(max-min), scaled by item level.

[affix:of_might]
name=of Might
stat=might
min=1
max=4

[affix:of_wits]
name=of Wits
stat=wits
min=1
max=4

[affix:of_grace]
name=of Grace
stat=grace
min=1
max=4

