# Element wheel (brief 4.6). beats = element this one deals +25% damage against.
# fire > nature > tide > storm > void > fire   (raw is neutral)
# hex = HUD/telegraph color

[element:fire]
name=Fire / Ash
beats=nature
hex=0xFF6A22

[element:nature]
name=Nature / Venom
beats=tide
hex=0x4ECB40

[element:tide]
name=Water / Tide
beats=storm
hex=0x2E9BFF

[element:storm]
name=Storm / Cold
beats=void
hex=0xB44EFF

[element:void]
name=Raw / Void
beats=fire
hex=0x8A8A9A

[element:raw]
name=Raw (physical)
beats=
hex=0xC8C8C8
