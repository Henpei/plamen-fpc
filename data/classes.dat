# Classes (brief 3.2). start_kit = base item ids. seed_skills = 2 guaranteed skill-tree seeds.

[class:wardancer]
name=Wardancer
desc=Skill-combat duelist. Parry and riposte on timing; mobility over armor. Low magic.
start_kit=weapon:rapier|offhand:parry_blade|body:duelist_leather
seed_skills=wardancer_flourish|wardancer_footwork
hp_mul=0.95
mana_mul=0.7
stam_mul=1.2

[class:emberweaver]
name=Emberweaver
desc=Elemental sorcerer of the fire/ash school. Crowd control and burning ground.
start_kit=weapon:ember_staff|body:ash_robe|amulet:cinder_charm
seed_skills=emberweaver_ignite|emberweaver_heat

[class:runeforger]
name=Runeforger
desc=Craft/enchant hybrid. Enchants own gear on the go; weaker in direct combat.
start_kit=weapon:rune_hammer|body:forger_apron|ring1:rune_ring
seed_skills=runeforger_marks|runeforger_temper
mana_mul=1.1

[class:shadowpact]
name=Shadowpact
desc=Dot/curse caster with lifesteal. Trades health for damage — hardcore synergy.
start_kit=weapon:pact_blade|body:pact_vestments|amulet:hunger_icon
seed_skills=shadowpact_bleed|shadowpact_siphon
hp_mul=0.85
mana_mul=1.3

[class:wardens_hound]
name=Warden's Hound
desc=Tank. Taunt, shield-bash, partyless vanguard builds.
start_kit=weapon:warhammer|offhand:bulwark|body:vanguard_plate|head:warden_helm
seed_skills=hound_bulwark|hound_bash
hp_mul=1.35
mana_mul=0.6
stam_mul=1.1

[class:lightbinder]
name=Lightbinder
desc=Heal/buff caster. Healing is scarce and valuable by design.
start_kit=weapon:light_wand|body:binder_robes|amulet:dawn_shard
seed_skills=lightbinder_mend|lightbinder_ward
mana_mul=1.4
hp_mul=0.9
