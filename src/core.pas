unit core;
{$mode objfpc}{$H+}
interface

const
  {$I version.inc}  // generated by tools/build.sh: PLAMEN_COMMIT, PLAMEN_BUILDTIME
  VERSION_STAMP = PLAMEN_COMMIT;
  BUILD_TIME = PLAMEN_BUILDTIME;
  SAVE_MAGIC = 'PLAMSAVE';
  SAVE_VERSION: Integer = 1;
  MAX_FLAGS = 4096;

type
  TStrArray = array of string;
  TFlag = record key, value: string; end;
  TFlagDB = record
    n: Integer;
    items: array[0..MAX_FLAGS - 1] of TFlag;
  end;

{ Logging. Log() -> console + plamen.log. Fatal() -> stderr + error.log + halt(1).
  LAW: no silent fallbacks; every unrecoverable problem is loud and fatal. }
procedure Log(const s: string);
procedure Fatal(const s: string);          // loud, logged, exit code 1
procedure FatalF(const fmt: string; const args: array of const);

{ String utils }
function Trim(const s: string): string;
function Split(const s: string; sep: Char): TStrArray;
function SplitStr(const s, sep: string): TStrArray;
function Join(const parts: TStrArray; const sep: string): string;
function StartsWith(const s, pre: string): Boolean;
function Contains(const s, sub: string): Boolean;
function StrEq(const a, b: string): Boolean;
function Lower(const s: string): string;
function I2S(v: Integer): string;           // IntToStr shorthand
function F2S(v: Single; dec: Integer = 0): string;
function ParseIntStrict(const s: string; out v: Integer): Boolean;
function ParseFloatStrict(const s: string; out v: Single): Boolean;
function ParseBoolStrict(const s: string; out v: Boolean): Boolean;

{ Files. ReadTextFile is LOUD: missing file = Fatal. }
function ReadTextFile(const path: string): string;
function FileExistsOS(const path: string): Boolean;
procedure AppendLine(const path, line: string);
procedure WriteTextFile(const path, contents: string);

{ CRC32 (for save tamper detection) }
function CRC32Of(const data: array of Byte): LongWord;
function CRC32OfStr(const s: string): LongWord;

{ Deterministic-ish RNG (xorshift64*), seedable; used for loot so saves can record seed }
procedure SeedRNG(seed: UInt64);
function RndUInt64: UInt64;
function RndRange(lo, hi: Integer): Integer;      // inclusive both ends
function RndChance(p: Single): Boolean;           // 0..1
function RndPick(const list: TStrArray): string;

{ Flag database — single source of truth for quest/consequence state (brief 2.5) }
procedure FlagSet(var db: TFlagDB; const key, value: string);
function FlagGet(const db: TFlagDB; const key: string): string;  // '' if unset
function FlagHas(const db: TFlagDB; const key: string): Boolean;
function FlagEq(const db: TFlagDB; const key, value: string): Boolean;
procedure FlagCopy(var dst: TFlagDB; const src: TFlagDB);
function FlagCount(const db: TFlagDB): Integer;

{ Misc }
function ClampI(v, lo, hi: Integer): Integer;
function ClampF(v, lo, hi: Single): Single;
function PointDist(x1, y1, x2, y2: Single): Single;

implementation

uses SysUtils;

var
  logFile: TextFile;
  logOpen: Boolean = False;
  rngState: UInt64 = UInt64($9E3779B97F4A7C15);

procedure OpenLog;
begin
  if logOpen then Exit;
  try
    Assign(logFile, 'plamen.log');
    if FileExists('plamen.log') then Append(logFile) else Rewrite(logFile);
    logOpen := True;
  except
    on E: Exception do Writeln('log open failed: ', E.Message);
  end;
end;

procedure Log(const s: string);
begin
  Writeln(s);
  OpenLog;
  if logOpen then
  begin
    try
      Writeln(logFile, FormatDateTime('yyyy-mm-dd hh:nn:ss', Now) + ' ' + s);
      Flush(logFile);
    except
      on E: Exception do Writeln('log write failed: ', E.Message);
    end;
  end;
end;

procedure Fatal(const s: string);
var
  f: TextFile;
begin
  Writeln(StdErr, 'FATAL: ' + s);
  try
    Assign(f, 'error.log');
    if FileExists('error.log') then Append(f) else Rewrite(f);
    Writeln(f, FormatDateTime('yyyy-mm-dd hh:nn:ss', Now) + ' FATAL: ' + s);
    Writeln(f, 'commit=' + VERSION_STAMP + ' built=' + BUILD_TIME);
    Close(f);
  except
    on E: Exception do Writeln(StdErr, 'error.log write failed: ' + E.Message);
  end;
  Log('FATAL: ' + s);
  Halt(1);
end;

procedure FatalF(const fmt: string; const args: array of const);
begin
  Fatal(Format(fmt, args));
end;

function Trim(const s: string): string;
begin
  Result := SysUtils.Trim(s);
end;

function Split(const s: string; sep: Char): TStrArray;
var
  i, start: Integer;
begin
  Result := nil;
  SetLength(Result, 0);
  start := 1;
  for i := 1 to Length(s) do
    if s[i] = sep then
    begin
      SetLength(Result, Length(Result) + 1);
      Result[High(Result)] := Copy(s, start, i - start);
      start := i + 1;
    end;
  SetLength(Result, Length(Result) + 1);
  Result[High(Result)] := Copy(s, start, Length(s) - start + 1);
end;

function SplitStr(const s, sep: string): TStrArray;
var
  i, start: Integer;
begin
  Result := nil;
  if sep = '' then
  begin
    SetLength(Result, 1);
    Result[0] := s;
    Exit;
  end;
  start := 1;
  i := 1;
  while i <= Length(s) do
  begin
    if Copy(s, i, Length(sep)) = sep then
    begin
      SetLength(Result, Length(Result) + 1);
      Result[High(Result)] := Copy(s, start, i - start);
      Inc(i, Length(sep));
      start := i;
    end
    else
      Inc(i);
  end;
  SetLength(Result, Length(Result) + 1);
  Result[High(Result)] := Copy(s, start, Length(s) - start + 1);
end;

function Join(const parts: TStrArray; const sep: string): string;
var
  i: Integer;
begin
  Result := '';
  for i := 0 to High(parts) do
  begin
    if i > 0 then Result := Result + sep;
    Result := Result + parts[i];
  end;
end;

function StartsWith(const s, pre: string): Boolean;
begin
  Result := Copy(s, 1, Length(pre)) = pre;
end;

function Contains(const s, sub: string): Boolean;
begin
  Result := Pos(sub, s) > 0;
end;

function StrEq(const a, b: string): Boolean;
begin
  Result := a = b;
end;

function Lower(const s: string): string;
begin
  Result := SysUtils.LowerCase(s);
end;

function I2S(v: Integer): string;
begin
  Result := IntToStr(v);
end;

function F2S(v: Single; dec: Integer = 0): string;
begin
  Result := Format('%.*f', [dec, v]);
end;

function ParseIntStrict(const s: string; out v: Integer): Boolean;
var
  e: Integer;
begin
  Val(Trim(s), v, e);
  Result := e = 0;
end;

function ParseFloatStrict(const s: string; out v: Single): Boolean;
var
  e: Integer;
begin
  Val(Trim(s), v, e);
  Result := e = 0;
end;

function ParseBoolStrict(const s: string; out v: Boolean): Boolean;
var
  t: string;
begin
  t := Lower(Trim(s));
  if (t = 'true') or (t = '1') or (t = 'yes') then begin v := True; Result := True; end
  else if (t = 'false') or (t = '0') or (t = 'no') then begin v := False; Result := True; end
  else Result := False;
end;

function FileExistsOS(const path: string): Boolean;
begin
  Result := SysUtils.FileExists(path);
end;

function ReadTextFile(const path: string): string;
var
  f: TextFile;
  line: string;
begin
  if not FileExistsOS(path) then
    FatalF('missing data file (no silent fallback): %s', [path]);
  Result := '';
  Assign(f, path);
  try
    Reset(f);
    Result := '';
    while not Eof(f) do
    begin
      Readln(f, line);
      Result := Result + line + #10;
    end;
    Close(f);
  except
    on E: Exception do
      FatalF('failed reading %s: %s', [path, E.Message]);
  end;
end;

procedure AppendLine(const path, line: string);
var
  f: TextFile;
begin
  Assign(f, path);
  if FileExists(path) then Append(f) else Rewrite(f);
  Writeln(f, line);
  Close(f);
end;

procedure WriteTextFile(const path, contents: string);
var
  f: TextFile;
begin
  Assign(f, path);
  try
    Rewrite(f);
    Write(f, contents);
    Close(f);
  except
    on E: Exception do FatalF('failed writing %s: %s', [path, E.Message]);
  end;
end;

var
  crcTable: array[0..255] of LongWord;
  crcReady: Boolean = False;

procedure InitCRC;
var
  i, j: Integer;
  c: LongWord;
begin
  if crcReady then Exit;
  for i := 0 to 255 do
  begin
    c := LongWord(i);
    for j := 0 to 7 do
      if (c and 1) <> 0 then c := (c shr 1) xor $EDB88320 else c := c shr 1;
    crcTable[i] := c;
  end;
  crcReady := True;
end;

function CRC32Of(const data: array of Byte): LongWord;
var
  i: Integer;
  c: LongWord;
begin
  InitCRC;
  c := $FFFFFFFF;
  for i := 0 to High(data) do
    c := crcTable[(c xor data[i]) and $FF] xor (c shr 8);
  Result := c xor $FFFFFFFF;
end;

function CRC32OfStr(const s: string): LongWord;
var
  i: Integer;
  c: LongWord;
begin
  InitCRC;
  c := $FFFFFFFF;
  for i := 1 to Length(s) do
    c := crcTable[(c xor Ord(s[i])) and $FF] xor (c shr 8);
  Result := c xor $FFFFFFFF;
end;

procedure SeedRNG(seed: UInt64);
begin
  if seed = 0 then seed := UInt64($9E3779B97F4A7C15);
  rngState := seed;
end;

function RndUInt64: UInt64;
var
  x: UInt64;
begin
  x := rngState;
  x := x xor (x shl 13);
  x := x xor (x shr 7);
  x := x xor (x shl 17);
  rngState := x;
  Result := x;
end;

function RndRange(lo, hi: Integer): Integer;
begin
  if hi < lo then FatalF('RndRange inverted: %d > %d', [lo, hi]);
  Result := lo + Integer(RndUInt64 mod UInt64(hi - lo + 1));
end;

function RndChance(p: Single): Boolean;
begin
  Result := (RndUInt64 mod 1000000) < Round(p * 1000000);
end;

function RndPick(const list: TStrArray): string;
begin
  if Length(list) = 0 then Fatal('RndPick on empty list');
  Result := list[RndRange(0, High(list))];
end;

procedure FlagSet(var db: TFlagDB; const key, value: string);
var
  i: Integer;
begin
  for i := 0 to db.n - 1 do
    if db.items[i].key = key then
    begin
      db.items[i].value := value;
      Exit;
    end;
  if db.n >= MAX_FLAGS then Fatal('flag DB overflow');
  db.items[db.n].key := key;
  db.items[db.n].value := value;
  Inc(db.n);
end;

function FlagGet(const db: TFlagDB; const key: string): string;
var
  i: Integer;
begin
  for i := 0 to db.n - 1 do
    if db.items[i].key = key then Exit(db.items[i].value);
  Result := '';
end;

function FlagHas(const db: TFlagDB; const key: string): Boolean;
var
  i: Integer;
begin
  for i := 0 to db.n - 1 do
    if db.items[i].key = key then Exit(True);
  Result := False;
end;

function FlagEq(const db: TFlagDB; const key, value: string): Boolean;
begin
  Result := FlagGet(db, key) = value;
end;

procedure FlagCopy(var dst: TFlagDB; const src: TFlagDB);
var
  i: Integer;
begin
  dst.n := src.n;
  for i := 0 to src.n - 1 do
    dst.items[i] := src.items[i];
end;

function FlagCount(const db: TFlagDB): Integer;
begin
  Result := db.n;
end;

function ClampI(v, lo, hi: Integer): Integer;
begin
  if v < lo then Exit(lo);
  if v > hi then Exit(hi);
  Result := v;
end;

function ClampF(v, lo, hi: Single): Single;
begin
  if v < lo then Exit(lo);
  if v > hi then Exit(hi);
  Result := v;
end;

function PointDist(x1, y1, x2, y2: Single): Single;
begin
  Result := Sqrt((x2 - x1) * (x2 - x1) + (y2 - y1) * (y2 - y1));
end;

end.
